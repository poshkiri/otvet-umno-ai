{
  "name": "otvet-umno-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Telegram bot for analyzing conversations and drafting strong replies",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
