{
  "name": "otvet-umno-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Telegram bot for analyzing conversations and drafting strong replies",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "start": "node dist/src/index.js",
    "build": "npm run build:bot && npm run build:webapp",
    "build:bot": "tsc -p tsconfig.json",
    "build:webapp": "tsc -p webapp/tsconfig.json && vite build --config webapp/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@grammyjs/runner": "^2.0.3",
    "@radix-ui/react-icons": "^1.3.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "grammy": "^1.45.1",
    "motion": "^12.42.2",
    "openai": "^7.4.0",
    "posthog-node": "^5.48.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  }
}
